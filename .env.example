# Public application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_VERSION=development

# Legal identity — all values are mandatory for production
VITE_PUBLIC_LEGAL_NAME=
VITE_PUBLIC_LEGAL_STREET=
VITE_PUBLIC_LEGAL_POSTAL_CITY=
VITE_PUBLIC_MANAGING_DIRECTOR=
VITE_PUBLIC_REGISTER_COURT=
VITE_PUBLIC_REGISTER_NUMBER=
VITE_PUBLIC_VAT_ID=
VITE_PUBLIC_EDITORIAL_RESPONSIBLE=
VITE_PUBLIC_SUPPORT_PHONE=
VITE_PUBLIC_SUPPORT_EMAIL=
VITE_PUBLIC_LEGAL_EMAIL=
VITE_PUBLIC_PRIVACY_EMAIL=
VITE_PUBLIC_DPO_EMAIL=
VITE_PUBLIC_WHATSAPP_NUMBER=
VITE_PUBLIC_FACEBOOK_URL=
VITE_PUBLIC_INSTAGRAM_URL=
VITE_PUBLIC_LINKEDIN_URL=
VITE_PUBLIC_YOUTUBE_URL=
VITE_PUBLIC_X_URL=

# Supabase — service-role values are server-only
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Abuse prevention and internal health checks (use random values >= 32 chars)
RATE_LIMIT_SALT=
READINESS_TOKEN=
# Bearer secret used by a daily scheduler to invoke the retention worker.
RETENTION_WORKER_SECRET=

# AI gateway
LOVABLE_API_KEY=
AI_PROCESSING_ENABLED=false
# Set true only after legal/security approval of the provider agreement and data flow.
AI_PROVIDER_DPA_CONFIRMED=false

# Malware scanner. Production requires all three values. The scanner POSTs a
# signed result to APP_URL/api/internal/vault-scan-result.
VAULT_SCANNER_URL=
VAULT_SCANNER_BEARER_TOKEN=
VAULT_SCANNER_WEBHOOK_SECRET=
# Local-only bypass; scripts/validate-production-env.mjs rejects it in production.
VAULT_SCANNER_MODE=disabled

# Web push
VAPID_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@beistandplus.de
VITE_NATIVE_PUSH_ENABLED=false
NATIVE_PUSH_DELIVERY_ENDPOINT=
NATIVE_PUSH_DELIVERY_BEARER_TOKEN=

# Payments
PAYMENTS_ENV=sandbox
PAYMENTS_ALLOWED_RETURN_ORIGINS=
VITE_PAYMENTS_CLIENT_TOKEN=
STRIPE_SANDBOX_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
STRIPE_LIVE_API_KEY=
PAYMENTS_LIVE_WEBHOOK_SECRET=

# This ledger records sandbox accounting transitions; it never moves funds.
ENABLE_SANDBOX_PAYOUT_LEDGER=false

# Development only. Production validation rejects this flag.
ENABLE_PARTNER_DEMOS=false

# Optional contracted referral integrations. With no credentials, the related
# customer workflow fails closed and never returns simulated production data.
FEATHER_API_KEY=
FEATHER_MGA_ID=
TAXFIX_PARTNER_ID=
SAVD_API_KEY=

# Transactional delivery
EMAIL_DELIVERY_ENDPOINT=
EMAIL_DELIVERY_BEARER_TOKEN=
CONTACT_FROM_EMAIL=
CONTACT_TEAM_EMAIL=
PARTNER_DELIVERY_WORKER_SECRET=
PARTNER_DELIVERY_ALLOWED_HOSTS=

# Capacitor. Set to the deployed HTTPS app URL before `npm run mobile:sync`.
CAPACITOR_SERVER_URL=
# Store release identities used to generate and verify Universal/App Links.
APPLE_TEAM_ID=
IOS_BUNDLE_ID=de.beistandplus.app
ANDROID_PACKAGE_NAME=de.beistandplus.app
ANDROID_SHA256_FINGERPRINTS=
